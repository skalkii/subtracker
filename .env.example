# Postgres connection. Defaults match docker-compose.yml.
DATABASE_URL=postgres://subtracker:subtracker@localhost:5432/subtracker

# Single-password gate. Pick something memorable. Anything non-empty works.
APP_PASSWORD=changeme

# Used to sign the auth cookie (HMAC). MUST be >=32 chars.
# Generate: openssl rand -hex 32
AUTH_SECRET=replace_with_at_least_32_chars_of_random_hex_data
